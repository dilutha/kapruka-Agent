# Copy to .env.local for local dev, or set these in the Vercel project's
# Environment Variables settings for deployment.

# Backend API base URL. Falls back to http://localhost:3001/api/v1 in code
# (src/lib/api-client.ts) if unset — that fallback is for local dev only.
# MUST be set to the deployed backend's public URL in production, or the
# deployed frontend will try to call localhost from users' browsers.
NEXT_PUBLIC_API_URL="https://your-backend.example.com/api/v1"

# Auth (Clerk) — must be the SAME Clerk instance as the backend's
# CLERK_SECRET_KEY/CLERK_PUBLISHABLE_KEY.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_live_or_test_..."
CLERK_SECRET_KEY="sk_live_or_test_..."

NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL="/"
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL="/"
