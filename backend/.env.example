# Copy to .env and fill in real values. validateSecrets() in
# src/common/security/security.config.ts hard-fails on boot if any
# non-optional variable below is missing or malformed — this file exists so a
# fresh deploy (or teammate) knows the full list without reading that code.

# Database (Supabase) — DATABASE_URL should be the pooled connection string,
# DIRECT_URL the direct one (used by Prisma migrations).
DATABASE_URL="postgresql://user:password@host:5432/postgres?pgbouncer=true"
DIRECT_URL="postgresql://user:password@host:5432/postgres"

# Auth (Clerk) — from your Clerk dashboard, must match the frontend's
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY (same Clerk instance on both sides).
CLERK_SECRET_KEY="sk_live_or_test_..."
CLERK_PUBLISHABLE_KEY="pk_live_or_test_..."
# 32 random bytes, hex-encoded (64 chars) — e.g. `openssl rand -hex 32`
GUEST_TOKEN_SECRET=""

# AI — a Google AI Studio key (https://aistudio.google.com/apikey), for the
# direct Generative Language API. GEMINI_MODEL/TIMEOUT_MS/MAX_RETRIES are
# optional; code defaults are in src/config/ai.config.ts.
GEMINI_API_KEY=""
# GEMINI_MODEL="gemini-3.6-flash"
# GEMINI_TIMEOUT_MS="20000"
# GEMINI_MAX_RETRIES="3"

# Redis — used for rate-limit counters, agent-state cache, and intent-
# classification caching. Managed Redis (Upstash, Redis Cloud, etc.) in prod.
REDIS_URL="redis://localhost:6379"

# MCP — the Kapruka MCP server's Streamable HTTP endpoint (not /sse).
KAPRUKA_MCP_SERVER_URL="https://mcp.kapruka.com/mcp"
# MCP_TIMEOUT_MS="10000"
# MCP_HEARTBEAT_MS="30000"

# App
NODE_ENV="production"
PORT="3001"
# The deployed frontend's origin(s) — used by CORS and logging. Comma-
# separated if there's more than one (e.g. a preview + production URL).
NEXTJS_URL="https://your-frontend.vercel.app"
CORS_ALLOWED_ORIGINS="https://your-frontend.vercel.app"

# Optional
# SENTRY_DSN=""
# POSTHOG_KEY=""
